# bump: nnn-version /NNN_VERSION="(.*)"/ https://github.com/jarun/nnn/releases|re:/nnn v([0-9.]+)/$1/|semver:*
NNN_VERSION="5.1"

###
### Build control file for the nnn port
###

###
### Required Environment Variables
###
export ZOPEN_BUILD_LINE="STABLE"
export ZOPEN_STABLE_URL="https://github.com/jarun/nnn/archive/refs/tags/v${NNN_VERSION}.tar.gz"
export ZOPEN_STABLE_DEPS="make ncurses readline sed pkgconfig coreutils"
export ZOPEN_DEV_URL=""
export ZOPEN_DEV_DEPS="make ncurses readline sed pkgconfig"
export ZOPEN_CATEGORIES="utilities"
export ZOPEN_RUNTIME_DEPS=""
# export ZOPEN_SYSTEM_PREREQ="zos25" # optional system pre-req (default=zos25)


###
### Build settings (Port type: BUILD, Build system: GNU Make)
###
export ZOPEN_CONFIGURE="skip"
export ZOPEN_CHECK="skip"
### Optional Settings for GNU Make build system (Autotools)
#export ZOPEN_EXTRA_CONFIGURE_OPTS="--with-ssl" # Add any additional configure options here
export ZOPEN_INSTALL_OPTS="install PREFIX=\${ZOPEN_INSTALL_DIR}"
#export ZOPEN_EXTRA_CFLAGS="" # Add any additional compiler options here
export ZOPEN_EXTRA_CPPFLAGS="-D__XPLAT=1 -D_POSIX_C_SOURCE=200809L"

###
### Required user-supplied functions
###

zopen_check_results() {
  dir="$1" 
  pfx="$2" 
  chk="$1/$2_check.log"
  # Add logic to extract the test results here:
  echo "actualFailures:0" 
  echo "totalTests:1" 
  echo "expectedFailures:0"
  echo "expectedTotalTests:1"
}

zopen_get_version() {
  ./nnn -V
}


